        <div class="card card-stat h-100"><div class="card-body"><i class="fas fa-users stat-icon text-secondary"></i><h6 class="card-subtitle mb-2 text-muted">العملاء النشطين</h6><p class="stat-number"><?= $stats['active_clients'] ?? 0 ?></p></div></div>
    </div>
</div>

<!-- التنبيهات والرسوم البيانية -->
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header"><h5 class="mb-0"><i class="fas fa-bell text-warning me-2"></i>تنبيهات هامة</h5></div>
            <div class="list-group list-group-flush">
                <a href="#" class="list-group-item list-group-item-action fw-bold text-danger"><i class="fas fa-file-invoice-dollar fa-fw me-3"></i>دفعات متأخرة <span class="badge bg-danger float-end"><?= count($late_payments) ?></span></a>
                <a href="#" class="list-group-item list-group-item-action fw-bold text-warning"><i class="fas fa-file-signature fa-fw me-3"></i>عقود تنتهي قريباً <span class="badge bg-warning float-end"><?= count($expiring_contracts) ?></span></a>
                <a href="#" class="list-group-item list-group-item-action"><i class="fas fa-id-card fa-fw me-3"></i>وثائق منتهية <span class="badge bg-secondary float-end">0</span></a>
            </div>
        </div>
