    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header"><h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>حالة الوحدات</h5></div>
            <div class="card-body d-flex justify-content-center align-items-center" style="min-height: 250px;">
                <canvas id="unitsStatusChart"></canvas>
            </div>
        </div>
    </div>
</div>

<script>
// ... (كود Chart.js يبقى كما هو) ...
document.addEventListener('DOMContentLoaded', function () {
    const ctx = document.getElementById('unitsStatusChart').getContext('2d');
    new Chart(ctx, {
        type: 'doughnut', data: { labels: <?= $chart_labels ?>, datasets: [{ label: 'عدد الوحدات', data: <?= $chart_values ?>, backgroundColor: ['rgba(40, 167, 69, 0.7)','rgba(255, 193, 7, 0.7)','rgba(220, 53, 69, 0.7)'], borderColor: ['#fff'], borderWidth: 2 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
    });
});
</script>